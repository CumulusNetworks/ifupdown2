auto lo
iface lo inet loopback

# The primary network interface
auto eth0
iface eth0 inet dhcp
    vrf mgmt

auto mgmt
iface mgmt
    vrf-table auto

auto swp_AA_
iface swp_AA_

auto swp_BB_
iface swp_BB_

auto br1
iface br1
      bridge-vlan-aware yes
      bridge-stp on
      bridge-ports swp_AA_
      bridge-vids 10,20

auto br2
iface br2
      bridge-vlan-aware yes
      bridge-stp on
      bridge-ports swp_BB_
      bridge-vids 30,40
