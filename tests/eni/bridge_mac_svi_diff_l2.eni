auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp
    ip-forward off
    ip6-forward off
    vrf mgmt

auto mgmt
iface mgmt
    address 127.0.0.1/8
    address 127.0.1.1/8
    address ::1/128
    vrf-table auto

auto swp_AA_
iface swp_AA_

auto br_mac
iface br_mac
    bridge-ports swp_AA_
    bridge-vlan-aware yes
    bridge-vids 100 200
    bridge-pvid 100
    hwaddress 02:00:00:00:10:01

auto br_mac.100
iface br_mac.100

auto br_mac.200
iface br_mac.200
    hwaddress 02:00:00:00:20:01
