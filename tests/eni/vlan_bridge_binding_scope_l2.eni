auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp
    vrf mgmt

auto mgmt
iface mgmt
    vrf-table auto

auto dummy_raw
iface dummy_raw
    link-type dummy

auto vlan100
iface vlan100
    vlan-raw-device dummy_raw
    vlan-id 100
    vlan-bridge-binding on

auto dummy_port
iface dummy_port
    link-type dummy

auto br_bind
iface br_bind
    bridge-vlan-aware yes
    bridge-ports dummy_port
    bridge-vids 200

auto br_bind.200
iface br_bind.200
    vlan-bridge-binding on
